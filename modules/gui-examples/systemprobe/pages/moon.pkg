// 演示板各页内容（G7 新栈）。每页一个文件；页内私有状态留在页函数体内，
// 跨页共享状态从 `shared` 的 `ProbeApp` 取。探针页真调本机能力，图表页
// 为内置演示数据。
import {
  "NoahLiu/yoga-mbt/src" @yoga,
  "NoahLiu/native-gui/core",
  "NoahLiu/native-gui/ui",
  "NoahLiu/native-gui/sys" @sys,
  "NoahLiu/native-gui/chart" @charts,
  "NoahLiu/native-gui/dbus" @dbus,
  "NoahLiu/gui-media/media" @media,
  "NoahLiu/gui-examples/systemprobe/shared",
}

supported_targets = "native"

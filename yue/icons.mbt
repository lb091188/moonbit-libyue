      p.bezier_curve_to(cx + 0.5608 * u, cy + -0.3288 * u, cx + 0.3062 * u, cy + -0.4783 * u, cx + 0 * u, cy + -0.4917 * u)
      p.close_path()
      p.move_to(cx + 0.6987 * u, cy + -0.825 * u)
      p.line_to(cx + 0.8165 * u, cy + -0.7072 * u)
      p.line_to(cx + -0.7155 * u, cy + 0.825 * u)
      p.line_to(cx + -0.8333 * u, cy + 0.7072 * u)
      p.close_path()
      p.move_to(cx + 0 * u, cy + -0.325 * u)

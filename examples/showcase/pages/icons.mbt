        icon_grid(
          [
            @yue.YhTreeStructure, @yue.YhTreeTable, @yue.YhTable,
            @yue.YhTab, @yue.YhTextField, @yue.YhTextarea,
            @yue.YhNumberField, @yue.YhSelectField, @yue.YhEditTable,

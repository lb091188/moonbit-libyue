///|
fn draw_icon_chunk_7(
    p : Painter,
    kind : IconKind,
    cx : Double,
    cy : Double,
    s : Double,
) -> Unit {
  match kind {
    YhReconciliationFill => { // reconciliation-fill
      let u = s * 0.88
      p.begin_path()
      p.move_to(cx + 0.41 * u, cy + 0.2775 * u)

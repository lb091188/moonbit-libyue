// 演示板共享层（G7 新栈）：跨页状态 App + 页面「段」装配。
// 原先叫 `ui/`，与组件库包名冲（新栈组件库就是 `ui`），改为 `shared/`。
import {
  "NoahLiu/native-gui/base",
  "NoahLiu/native-gui/widget" @widget,

  "NoahLiu/native-gui/ui",
  "NoahLiu/native-gui/sys",
  "NoahLiu/native-gui/style" @style,
  "NoahLiu/yoga-mbt/src" @yoga,
}

supported_targets = "native"

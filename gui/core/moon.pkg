// G9 Batch 2 后的门面包：实现已拆到 `base`（响应式/几何/记账）、`shell`（壳层窗/泵/
// 系统能力）、`widget`（控件宿主/声明式/浮层/拖放/App 主体），本包只剩转发层
// compat*.mbt——让 `@core.*` 调用点在迁移期不改写。全量替换（TODO §1 G9 收尾）后
// 本包连同 compat 文件一起退场。

supported_targets = "native"

import {
  "NoahLiu/native-gui/base",
  "NoahLiu/native-gui/shell" @shell,
  "NoahLiu/native-gui/widget" @widget,
  "NoahLiu/native-gui/win",
  "NoahLiu/native-gui/sys" @sys,
}

import {
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "native"

// stub.c 一个文件四条分支：_WIN32 真 Win32 实现（moon native-stub 自编，
// windows.h 走 MSVC 自带 SDK 路径，实测可达）、WM_STUB_GTK 真 GTK 实现
// （仅 scripts/prebuild.py 在 Linux 带 -DWM_STUB_GTK + pkg-config 头编成
// build/libyue_win_stub.a 经 link_flags 传入；native-stub 拿不到 GTK 头路径，
// 实测同 G0 探针）、WM_STUB_MAC 真 Cocoa 实现（Objective-C，仅 prebuild 在
// Darwin 带 -DWM_STUB_MAC -x objective-c -fobjc-arc 编成
// build/libyue_win_stub_mac.a 经 link_flags 传给 win/sys/web；native-stub
// 拿不到框架实现，同 GTK 那条）、其余平台占位。Linux/macOS 上 native-stub
// 的那次编译都落不进任何实现分支（分支条件带 __linux__/__APPLE__ 闸），编出
// 空 TU，防 wm_* 与 prebuild 的 .a 双定义。Windows 的系统库链接参数（user32
// 等）由 prebuild 的 Windows 分支下发，macOS 的框架参数（Cocoa 等）由 Darwin
// 分支下发；链接参数按 AGENTS 规则 1 全部由 prebuild 托管。
//
// win_gui.c 只有一段 MSVC 链接 pragma（GUI 子系统 + 入口点）与一个 marker
// 符号，无平台实现；与 stub.c 同编进包归档 libwin.lib，被 window.mbt 的
// init_backend 引用后其 .drectve 才会被链接器读到（细则见文件头）。
options(
  "native-stub": [ "stub.c", "win_gui.c" ],
)

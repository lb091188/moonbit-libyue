// G7 示例迁移：演示板改走新栈（`core` + `ui`）。
// 本包只做装配：侧栏导航 + 页切换 + 主题跟随；共享层在 `shared/`，
// 各页内容在 `pages/`。
import {
  "NoahLiu/yoga-mbt/src" @yoga,
  "NoahLiu/native-gui/core",
  "NoahLiu/native-gui/ui",
  "NoahLiu/native-gui/theme",
  "NoahLiu/native-gui/icons",
  "NoahLiu/native-gui/win",
  "NoahLiu/native-gui/dbus" @dbus,
  "NoahLiu/native-gui-examples/showcase/shared",
  "NoahLiu/native-gui-examples/showcase/pages",
}

pkgtype(kind: "executable")

supported_targets = "native"

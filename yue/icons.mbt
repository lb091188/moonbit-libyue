///|
fn draw_icon_chunk_2(
    p : Painter,
    kind : IconKind,
    cx : Double,
    cy : Double,
    s : Double,
) -> Unit {
  match kind {
    YhWallet1 => { // wallet
      let u = s * 0.88
      p.begin_path()
      p.move_to(cx + 0.2857 * u, cy + -0.4286 * u)
      p.line_to(cx + 0.1429 * u, cy + -0.4286 * u)
      p.line_to(cx + 0.1429 * u, cy + -0.7857 * u)
      p.line_to(cx + -0.8571 * u, cy + -0.7857 * u)
      p.line_to(cx + -0.8571 * u, cy + 0.7857 * u)
      p.line_to(cx + 0 * u, cy + 0.7857 * u)

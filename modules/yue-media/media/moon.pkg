// 媒体引擎（批 D）：ffmpeg 解码 + miniaudio 设备直出，档位是 **CPU 回灌 + 软解**
// （方案 §4.2 第 3 条）。本包只有引擎、没有 UI：帧以 RGBA 字节交出，由调用方
// （yue/ui 的播放器组件或示例）灌进 @render 的 Bitmap 再走 Painter 合成。
//
// 依赖纪律：不依赖 webview、不依赖 UI 层——媒体层与网页层各自只依赖窗口/布局/
// 事件层，所以两批可以并行推进、互不阻塞。
//
// 归属：本包自 2026-10-12 起住在**独立模块** `NoahLiu/yue-media`（原先在主模块的
// `yue/media`）——只有这样才能让主模块的依赖闭包里不出现 `ffmpeg-mbt`，媒体对
// 主模块消费者保持「模块级可选」。本包的系统库链接参数由本模块自己的
// `modules/yue-media/prebuild.py` 按包名 `NoahLiu/yue-media/media` 下发。

supported_targets = "native"

import {
  "NoahLiu/yoga-mbt/src" @yoga,
  "NoahLiu/ffmpeg-mbt/src" @ffmbt,
  "NoahLiu/moonbit-libyue/yue/core",
  "NoahLiu/moonbit-libyue/yue/render",
  "NoahLiu/moonbit-libyue/yue/text",
  "NoahLiu/moonbit-libyue/yue/theme",
}

options(
  "native-stub": [ "audio_stub.c" ],
)

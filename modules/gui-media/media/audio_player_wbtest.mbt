///|
/// 快退/快进落点：正常区间、两端钳位、时长未知（容器无时长头）只钳下界。
test "音频跳转落点：±5 秒、两端钳位、时长未知不回落" {
  assert_eq(ap_skip(10.0, 60.0, 5.0), 15.0)
  assert_eq(ap_skip(10.0, 60.0, -5.0), 5.0)
  assert_eq(ap_skip(58.0, 60.0, 5.0), 60.0) // 钳在时长
  assert_eq(ap_skip(2.0, 60.0, -5.0), 0.0) // 钳在起点
  // 时长未知：vp_clamp_t 会把任何落点打回 0，这里必须只钳下界
  assert_eq(ap_skip(12.0, 0.0, 5.0), 17.0)
  assert_eq(ap_skip(3.0, 0.0, -5.0), 0.0)
}

fn main {
  if !@yue.initialize() {
    println("GUI 初始化失败")
    return
  }
  let window = @yue.Window::new()
  window.set_content_size(780.0, 1080.0)
  window.set_title("icon-probe")
  window.center()
  let box_ = @yue.Container::new()
  box_.set_style("width", 780.0)
  box_.set_style("height", 1080.0)
  box_.on_draw(fn(p) {
    for i, k in icons {
      let col = i % 24
      let row = i / 24
      let x = 16.0 + col.to_double() * 32.0
      let y = 16.0 + row.to_double() * 32.0
      @yue.draw_icon(p, k, x, y, 12.0, "#222222")
    }
  })
  window.set_content(box_)
  window.activate()
  println("probe-icon ready")
  @yue.run()
}

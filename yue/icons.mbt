///|
fn draw_icon_chunk_8(
    p : Painter,
    kind : IconKind,
    cx : Double,
    cy : Double,
    s : Double,
) -> Unit {
  match kind {
    YhRollfront => { // rollfront
      let u = s * 0.88
      p.begin_path()
      p.move_to(cx + 0.7031 * u, cy + -0.491 * u)
      p.line_to(cx + 0.4167 * u, cy + -0.7772 * u)

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
}

supported_targets = "native"

// GTK 端不由 moon 编译：它需要 gtk/pango/cairo 的头文件搜索路径，而 moon 的
// link_configs 只有链接期字段（c_flags 会被静默忽略，实测）。改由
// scripts/prebuild.py 编成 build/libime_probe_stub.a 后经 link_flags 传入
// （与 shim 同一形态）。这里只带非 Linux 平台的占位实现，保证三全包链接不断符号。
pkgtype(kind: "executable")

options(
  "native-stub": [ "ime_probe_stub_portable.c" ],
)
